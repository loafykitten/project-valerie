# Copy to .env locally. Credentials and state must never be committed.
VALERIE_HOST=127.0.0.1
VALERIE_PORT=3100
VALERIE_DATABASE=./data/valerie.sqlite
# The service binds only to loopback. Use SSH or owner-restricted Tailscale Serve remotely.
# Comma-separated exact dashboard origins; needed for Vite dev and reverse proxy.
VALERIE_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://valerie.loafykitten.cafe
VALERIE_TIMEZONE=America/Chicago
# Optional read-only Markdown source for memory. Core/short memory works without a vault.
# VALERIE_VAULT_DIR=/absolute/path/to/vault
# Optional display label for the physical host when running in a container.
# VALERIE_HOST_LABEL=homelab

# Select the inference model and budgets in the Conversation dashboard.
NEURALWATT_API_KEY=
# Explicit process lifecycle switch; enabling requires a controlled restart.
VALERIE_TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
COMFYUI_BASE_URL=
# Absolute private directory containing the workflow template and prompt profile.
# Set both ComfyUI values to enable image tools; restart the API after changes.
COMFYUI_WORKFLOW_DIR=
